{
  "name": "playwright-cucumber-automation",
  "version": "1.0.0",
  "description": "Cross-browser BDD tests built with Playwright, Cucumber and TypeScript",
  "private": true,
  "scripts": {
    "test": "BROWSER=chromium cucumber-js",
    "test:smoke": "BROWSER=chromium cucumber-js --tags '@smoke'",
    "test:headed": "HEADLESS=false BROWSER=chromium cucumber-js",
    "test:chromium": "BROWSER=chromium cucumber-js",
    "test:firefox": "BROWSER=firefox cucumber-js",
    "test:webkit": "BROWSER=webkit cucumber-js",
    "test:typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
